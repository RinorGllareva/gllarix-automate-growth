# Data source: "demo" uses seeded fake data in the browser (no backend needed).
# "supabase" uses the Supabase project below (tables from supabase/migrations).
VITE_ATLAS_DATA=demo

# Demo mode only: shared password for the seeded demo users (see src/data/demo/seed.ts).
VITE_DEMO_PASSWORD=atlas-demo

# Supabase mode only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
